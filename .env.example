APP_NAME=Dashboard Financeiro
APP_VERSION=0.1.14
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
SESSION_NAME=dashboard_financeiro
SESSION_IDLE_TIMEOUT_MINUTES=15
AUDIT_LOG_RETENTION_DAYS=90

# Banco de dados
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dashboard_financeiro
DB_USERNAME=dashboard
DB_PASSWORD=

# Importacao da planilha
EXCEL_FILE=/opt/dashboard/storage/financeiro.xlsx
SHARED_EXCEL_URL=
IMPORT_TEMP_DIR=/tmp/dashboard-import
IMPORT_TIMEZONE=America/Sao_Paulo

# Microsoft Graph / OneDrive
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
MS_GRAPH_DRIVE_ID=
MS_GRAPH_FILE_ITEM_ID=
