APP_NAME=Dashboard Financeiro
APP_VERSION=0.1.34
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
SESSION_NAME=dashboard_financeiro
SESSION_IDLE_TIMEOUT_MINUTES=15
AUDIT_LOG_RETENTION_DAYS=90

# Banco de dados
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dashboard_financeiro
DB_USERNAME=dashboard
DB_PASSWORD=

# Importação da planilha
EXCEL_FILE=/var/www/dashboard.oficinadodev.com.br/html/storage/private/spreadsheets/financeiro.xlsx
SHARED_EXCEL_URL=
IMPORT_TEMP_DIR=/tmp/dashboard-import
IMPORT_TIMEZONE=America/Sao_Paulo
SPREADSHEET_IMPORT_SCHEDULE_ENABLED=false
SPREADSHEET_IMPORT_INTERVAL_MINUTES=30

# Discord
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_MARKET_LIST_CREATED=false
